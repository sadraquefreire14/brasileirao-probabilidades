---
import type { Snapshot } from '../lib/types';
import { pct } from '../lib/format';
import Crest from './Crest.astro';

interface Props { snap: Snapshot }
const { snap } = Astro.props;
const n = snap.rules.teams;
const positions = Array.from({ length: n }, (_, i) => i + 1);
// raiz quadrada realça probabilidades pequenas sem saturar as grandes
const alpha = (p: number) => (p <= 0 ? 0 : Math.min(1, 0.08 + Math.sqrt(p) * 0.92));
---

<section class="card" aria-labelledby="heat-title">
  <h2 id="heat-title">Onde cada clube deve terminar</h2>
  <p class="sub">Probabilidade de cada posição final. Quanto mais forte a cor, mais provável.</p>
  <div class="heat-wrap">
    <table class="heat">
      <thead>
        <tr>
          <th scope="col" class="l">Clube</th>
          {positions.map((p) => (
            <th scope="col" class:list={[p <= snap.rules.libertadores_direct && 'lib', p > n - snap.rules.relegated && 'rel']}>{p}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {snap.teams.map((t) => (
          <tr>
            <th scope="row" class="l"><span class="team"><Crest src={t.crest} size={18} /><span>{t.short}</span></span></th>
            {t.pos_probs.map((p, i) => (
              <td style={`--a:${alpha(p).toFixed(3)}`} title={`${t.short} em ${i + 1}º: ${pct(p)}`}>
                <span class="visually-hidden">{pct(p)}</span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .heat-wrap { overflow-x: auto; }
  .heat { border-collapse: separate; border-spacing: 2px; font-size: 0.78rem; width: 100%; }
  .heat th { color: var(--muted); font-weight: 500; padding: 2px 4px; white-space: nowrap; }
  .heat thead th { text-align: center; min-width: 22px; }
  .heat thead th.lib { color: var(--ok); }
  .heat thead th.rel { color: var(--bad); }
  .heat .l { text-align: left; color: var(--fg); padding-right: 10px; }
  .team { display: flex; align-items: center; gap: 6px; }
  .heat td {
    position: relative; /* contém o texto oculto (acessível) dentro da rolagem */
    height: 20px; min-width: 22px; border-radius: 3px;
    background: rgb(var(--heat) / var(--a));
  }
</style>
